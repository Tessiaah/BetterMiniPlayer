{
  "name": "better-mini-player",
  "version": "1.0.0",
  "private": true,
  "description": "A small YouTube mini-player with controls that operate the original video.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/playback.test.mjs",
    "test:browser": "playwright test",
    "test:youtube": "node scripts/test-youtube.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser",
    "package": "npm run build && node scripts/package.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
