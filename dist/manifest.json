{
  "manifest_version": 3,
  "name": "Better Mini Player",
  "version": "1.0.0",
  "description": "Pop out YouTube with working play, pause, and 10-second skip controls.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Better Mini Player — pop out this YouTube video",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
